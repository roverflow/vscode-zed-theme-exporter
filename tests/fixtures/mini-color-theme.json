{
  "name": "themename",
  "type": "dark",
  "colors": {
    "editor.background": "#102030",
    "editor.foreground": "#ccddee",
    "foreground": "#ccddee",
    "descriptionForeground": "#ccddee",
    "focusBorder": "#4080c0",
    "terminal.ansiRed": "#e06060",
    "terminal.ansiGreen": "#60c060",
    "terminal.ansiYellow": "#d0b040",
    "terminal.ansiBlue": "#4080c0",
    "terminal.ansiMagenta": "#c060c0",
    "terminal.ansiCyan": "#40c0c0",
    "editorError.foreground": null,
    "editor.selectionBackground": "#4080c055"
  },
  "tokenColors": [
    { "settings": { "background": "#102030", "foreground": "#ccddee" } },
    { "scope": "comment", "settings": { "foreground": "#5a6a7a", "fontStyle": "italic" } },
    { "scope": ["string", "string.quoted"], "settings": { "foreground": "#60c060" } },
    { "scope": "string", "settings": { "fontStyle": "italic" } },
    { "scope": "entity.name.function", "settings": { "foreground": "#40c0c0" } },
    { "scope": "meta.function-call", "settings": { "foreground": "#40c0c0" } },
    { "scope": "meta.function-call", "settings": { "fontStyle": "italic" } },
    { "scope": "keyword.control.flow", "settings": { "foreground": "#c060c0", "fontStyle": "bold" } },
    { "scope": "markup.bold", "settings": { "fontStyle": "bold" } }
  ],
  "semanticTokenColors": { "parameter": "#e0a060", "interface": { "foreground": "#d0b040", "italic": true } }
}
